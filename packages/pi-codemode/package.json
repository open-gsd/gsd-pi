{
  "name": "@gsd/pi-codemode",
  "version": "1.0.2",
  "description": "Codemode helpers (vendored from earendil-works/pi)",
  "type": "module",
  "gsd": {
    "linkable": true,
    "scope": "@gsd",
    "name": "pi-codemode"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./declarations": {
      "types": "./dist/declarations.d.ts",
      "import": "./dist/declarations.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js"
    },
    "./portable": {
      "types": "./dist/portable.d.ts",
      "import": "./dist/portable.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js"
    },
    "./worker": {
      "types": "./dist/runtime/worker.d.ts",
      "import": "./dist/runtime/worker.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.cjs && tsc -p tsconfig.json --incremental false"
  },
  "dependencies": {
    "quickjs-wasi": "3.6.2",
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "vitest": "4.1.12"
  }
}
