{
  "name": "@gsd/pi-ai",
  "version": "1.0.2",
  "description": "Unified LLM API (vendored from earendil-works/pi)",
  "type": "module",
  "gsd": {
    "linkable": true,
    "scope": "@gsd",
    "name": "pi-ai"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js"
    },
    "./session-resources": {
      "types": "./dist/session-resources.d.ts",
      "import": "./dist/session-resources.js"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js"
    },
    "./api/*": {
      "types": "./dist/api/*.d.ts",
      "import": "./dist/api/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js"
    },
    "./oauth": {
      "types": "./dist/oauth.d.ts",
      "import": "./dist/oauth.js"
    },
    "./bedrock-provider": {
      "types": "./dist/bedrock-provider.d.ts",
      "import": "./dist/bedrock-provider.js"
    },
    "./bun-oauth": {
      "types": "./dist/bun-oauth.d.ts",
      "import": "./dist/bun-oauth.js"
    },
    "./lazy-bedrock-provider": {
      "types": "./dist/lazy-bedrock-provider.d.ts",
      "import": "./dist/lazy-bedrock-provider.js"
    },
    "./lazy-oauth": {
      "types": "./dist/lazy-oauth.d.ts",
      "import": "./dist/lazy-oauth.js"
    }
  },
  "bin": {
    "pi-ai": "./bin/pi-ai.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate-models": "node scripts/generate-models.ts",
    "generate-image-models": "node scripts/generate-image-models.ts",
    "generate": "pnpm run generate-models && pnpm run generate-image-models",
    "build": "node ../../scripts/clean-package-dist.cjs && tsc -p tsconfig.json --incremental false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@aws-sdk/client-bedrock-runtime": "3.1127.0",
    "@aws-sdk/credential-provider-node": "3.972.82",
    "@google/genai": "3.6.1",
    "@smithy/node-http-handler": "4.12.1",
    "http-proxy-agent": "9.1.0",
    "https-proxy-agent": "9.1.0",
    "openai": "7.59.0",
    "partial-json": "0.1.7",
    "@gsd/pi-schema": "workspace:*",
    "@gsd/pi-telemetry": "workspace:*",
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "canvas": "3.2.3",
    "typebox": "1.3.27",
    "vitest": "4.1.12"
  }
}
